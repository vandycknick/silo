# Silo Rosetta acquisition probe, architecture-independent requirements.
# This profile boots one static PID1 from an initramfs and has no workload
# configuration layered beneath it.

CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_BASE_SMALL=y
CONFIG_SLUB_TINY=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
# Keep serial diagnostics, but not in-image symbol/config tables or allocator
# debugging. Retain the build-side .config, System.map and vmlinux for analysis.
CONFIG_PRINTK=y
CONFIG_LOG_BUF_SHIFT=14
# CONFIG_IKCONFIG is not set
# CONFIG_KALLSYMS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set

# This short-lived appliance has no disks, swap, suspend, or memory migration.
# Linux 7.2.2 supports the required FUSE/virtiofs path without CONFIG_BLOCK.
# CONFIG_BLOCK is not set
# CONFIG_SWAP is not set
# CONFIG_COMPACTION is not set
# CONFIG_MIGRATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM is not set
# CONFIG_CPU_ISOLATION is not set

# PID1 uses synchronous file operations, poll, clock_gettime and nanosleep.
# It does not need general-purpose process inspection or notification APIs.
# CONFIG_COREDUMP is not set
# CONFIG_ELF_CORE is not set
# CONFIG_CROSS_MEMORY_ATTACH is not set
# CONFIG_AIO is not set
# CONFIG_EPOLL is not set
# CONFIG_SIGNALFD is not set
# CONFIG_TIMERFD is not set
# CONFIG_EVENTFD is not set
# CONFIG_FHANDLE is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_MEMBARRIER is not set
# CONFIG_RSEQ is not set
# CONFIG_CACHESTAT_SYSCALL is not set
# CONFIG_SECCOMP is not set
# CONFIG_PROC_PAGE_MONITOR is not set
# CONFIG_DNOTIFY is not set
# CONFIG_INOTIFY_USER is not set

# No firmware-loading users or hardware-monitoring drivers. ARM64 selects
# POWER_SUPPLY itself; keep the required core rather than fighting Kconfig.
# CONFIG_FW_LOADER is not set
# CONFIG_HWMON is not set

# TTY selects the INPUT core in Linux 7.2.2. Keep that unavoidable core while
# excluding every input device family and virtual-terminal user interface.
CONFIG_INPUT=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_SERIO is not set
# CONFIG_VT is not set
# CONFIG_HID is not set

# The appliance has no executable scripts, modules, workload isolation,
# network stack, persistent block device, or general-purpose filesystems.
# CONFIG_MODULES is not set
# CONFIG_BINFMT_SCRIPT is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_NET is not set
# CONFIG_VSOCKETS is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_IO_URING is not set
# CONFIG_BLK_DEV is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_NFS_FS is not set

# Virtiofs is the appliance's only host data path. DAX, passthrough, CUSE and
# io_uring integration are intentionally outside the immutable read-only use.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# CONFIG_FUSE_PASSTHROUGH is not set
# CONFIG_FUSE_DAX is not set
# CONFIG_FS_DAX is not set
# CONFIG_CUSE is not set

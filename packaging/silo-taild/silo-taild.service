[Unit]
Description=Silo tailnet service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=silo-taild
Group=silo-taild
SupplementaryGroups=kvm
Environment=SILO_HOME=/var/lib/silo-taild
Environment=HOME=/var/lib/silo-taild
StateDirectory=silo-taild
StateDirectoryMode=0700
ExecStart=/usr/bin/taild --config /etc/silo-taild/config.yaml
# The command checks system state for stopping. Ordinary stop/restart leaves VMs running.
ExecStop=/usr/bin/taild stop-vms --only-when-shutting-down --config /etc/silo-taild/config.yaml
# VM workers outlive this daemon. Never kill the service cgroup during restart.
KillMode=process
Restart=on-failure
TimeoutStopSec=90
UMask=0077
DeviceAllow=/dev/kvm rw

[Install]
WantedBy=multi-user.target

# syntax=docker/dockerfile:1
FROM ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

ARG TARGETARCH
ARG RUST_VERSION=1.96.1
ARG GO_VERSION=1.26.5
ARG ZIG_VERSION=0.16.0
ARG CARGO_ZIGBUILD_VERSION=0.23.0

RUN apt-get update && apt-get install --yes --no-install-recommends \
    build-essential ca-certificates curl file git pkg-config python3 xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --silent --show-error https://sh.rustup.rs -o /tmp/rustup-init \
    && sh /tmp/rustup-init -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && /root/.cargo/bin/rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl \
    && /root/.cargo/bin/cargo install --locked cargo-zigbuild --version "${CARGO_ZIGBUILD_VERSION}" \
    && rm /tmp/rustup-init

RUN case "${TARGETARCH}" in \
      amd64) go_arch=amd64; zig_arch=x86_64 ;; \
      arm64) go_arch=arm64; zig_arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --silent --show-error "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" | tar -C /usr/local -xzf - \
    && curl --fail --location --silent --show-error "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-${zig_arch}-${ZIG_VERSION}.tar.xz" | tar -C /opt -xJf - \
    && ln -s "/opt/zig-linux-${zig_arch}-${ZIG_VERSION}/zig" /usr/local/bin/zig

ENV PATH=/root/.cargo/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
ENV CGO_ENABLED=0
WORKDIR /workspace
ENTRYPOINT ["make"]

# syntax=docker/dockerfile:1
FROM ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

ARG TARGETARCH

RUN apt-get update && apt-get install --yes --no-install-recommends \
    binutils build-essential ca-certificates curl file git pkg-config python3 xz-utils zstd \
    && rm -rf /var/lib/apt/lists/*

COPY release/toolchains.toml /opt/silo/toolchains.toml

RUN case "${TARGETARCH}" in \
      amd64) host_triple=x86_64-unknown-linux-gnu; go_arch=amd64; zig_arch=x86_64; rustup_sha=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10; go_sha=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053; zig_sha=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00; oras_sha=6cdc692f929100feb08aa8de584d02f7bcc30ec7d88bc2adc2054d782db57c64; rustup_config='rustup_linux_amd64_sha256 = "4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10"'; go_config='go_linux_amd64_sha256 = "5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053"'; zig_config='zig_linux_amd64_sha256 = "70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"'; oras_config='oras_linux_amd64_sha256 = "6cdc692f929100feb08aa8de584d02f7bcc30ec7d88bc2adc2054d782db57c64"' ;; \
      arm64) host_triple=aarch64-unknown-linux-gnu; go_arch=arm64; zig_arch=aarch64; rustup_sha=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792; go_sha=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49; zig_sha=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17; oras_sha=7649738b48fde10542bcc8b0e9b460ba83936c75fb5be01ee6d4443764a14352; rustup_config='rustup_linux_arm64_sha256 = "9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792"'; go_config='go_linux_arm64_sha256 = "fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49"'; zig_config='zig_linux_arm64_sha256 = "ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"'; oras_config='oras_linux_arm64_sha256 = "7649738b48fde10542bcc8b0e9b460ba83936c75fb5be01ee6d4443764a14352"' ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && grep -Fqx 'ubuntu_image = "ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90"' /opt/silo/toolchains.toml \
    && grep -Fqx 'ubuntu_release = "24.04"' /opt/silo/toolchains.toml \
    && grep -Fqx 'glibc = "2.39"' /opt/silo/toolchains.toml \
    && grep -Fqx 'rust = "1.96.1"' /opt/silo/toolchains.toml \
    && grep -Fqx 'rustup = "1.29.0"' /opt/silo/toolchains.toml \
    && grep -Fqx 'go = "1.26.5"' /opt/silo/toolchains.toml \
    && grep -Fqx 'zig = "0.16.0"' /opt/silo/toolchains.toml \
    && grep -Fqx 'cargo_zigbuild = "0.23.0"' /opt/silo/toolchains.toml \
    && grep -Fqx 'oras = "1.3.0"' /opt/silo/toolchains.toml \
    && grep -Fqx 'cargo_zigbuild_sha256 = "68c7df45b9d9934aaed5987fbf422b31419f81827b13a52251a61e1e772c6ff7"' /opt/silo/toolchains.toml \
    && grep -Fqx "${rustup_config}" /opt/silo/toolchains.toml \
    && grep -Fqx "${go_config}" /opt/silo/toolchains.toml \
    && grep -Fqx "${zig_config}" /opt/silo/toolchains.toml \
    && grep -Fqx "${oras_config}" /opt/silo/toolchains.toml \
    && curl --fail --location --silent --show-error "https://static.rust-lang.org/rustup/archive/1.29.0/${host_triple}/rustup-init" -o /tmp/rustup-init \
    && printf '%s  %s\n' "${rustup_sha}" /tmp/rustup-init | sha256sum -c - \
    && chmod 0755 /tmp/rustup-init \
    && RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.96.1 \
    && RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo /opt/cargo/bin/rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl \
    && curl --fail --location --silent --show-error "https://go.dev/dl/go1.26.5.linux-${go_arch}.tar.gz" -o /tmp/go.tar.gz \
    && printf '%s  %s\n' "${go_sha}" /tmp/go.tar.gz | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && curl --fail --location --silent --show-error "https://ziglang.org/download/0.16.0/zig-${zig_arch}-linux-0.16.0.tar.xz" -o /tmp/zig.tar.xz \
    && printf '%s  %s\n' "${zig_sha}" /tmp/zig.tar.xz | sha256sum -c - \
    && tar -C /opt -xJf /tmp/zig.tar.xz \
    && ln -s "/opt/zig-${zig_arch}-linux-0.16.0/zig" /usr/local/bin/zig \
    && curl --fail --location --silent --show-error "https://static.crates.io/crates/cargo-zigbuild/cargo-zigbuild-0.23.0.crate" -o /tmp/cargo-zigbuild.crate \
    && printf '%s  %s\n' '68c7df45b9d9934aaed5987fbf422b31419f81827b13a52251a61e1e772c6ff7' /tmp/cargo-zigbuild.crate | sha256sum -c - \
    && mkdir /tmp/cargo-zigbuild \
    && tar -C /tmp/cargo-zigbuild --strip-components=1 -xzf /tmp/cargo-zigbuild.crate \
    && RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo /opt/cargo/bin/cargo install --locked --path /tmp/cargo-zigbuild \
    && curl --fail --location --silent --show-error "https://github.com/oras-project/oras/releases/download/v1.3.0/oras_1.3.0_linux_${go_arch}.tar.gz" -o /tmp/oras.tar.gz \
    && printf '%s  %s\n' "${oras_sha}" /tmp/oras.tar.gz | sha256sum -c - \
    && tar -C /usr/local/bin -xzf /tmp/oras.tar.gz oras \
    && rm -rf /tmp/rustup-init /tmp/go.tar.gz /tmp/zig.tar.xz /tmp/cargo-zigbuild.crate /tmp/cargo-zigbuild /tmp/oras.tar.gz \
    && test "$(uname -m)" = "$(case "${TARGETARCH}" in amd64) printf x86_64 ;; arm64) printf aarch64 ;; esac)" \
    && /opt/cargo/bin/rustc --version | grep -F '1.96.1' \
    && /opt/cargo/bin/cargo --version | grep -F '1.96.1' \
    && /usr/local/go/bin/go version | grep -F 'go1.26.5' \
    && zig version | grep -Fx '0.16.0' \
    && /opt/cargo/bin/cargo-zigbuild --version | grep -F '0.23.0' \
    && oras version | grep -F '1.3.0'

ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
ENV CGO_ENABLED=0
RUN install -d -m 0777 /release-cache
WORKDIR /workspace
ENTRYPOINT ["make"]

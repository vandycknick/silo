# Silo Rosetta acquisition probe, ARM64 VZ virtual-platform requirements.

CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_NR_CPUS=4
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_TTY=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RANDOMIZE_BASE=y

# Preserve normal ARM64 defaults and errata, while excluding host-only policy
# and physical Apple platform support from this direct-boot virtual machine.
# CONFIG_COMPAT is not set
# CONFIG_EFI is not set
# CONFIG_ACPI is not set
# CONFIG_KVM is not set
# CONFIG_NUMA is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_AMBA_PL011 is not set

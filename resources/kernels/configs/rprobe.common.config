# Silo Rosetta acquisition probe, architecture-independent requirements.
# This profile boots one static PID1 from an initramfs and has no workload
# configuration layered beneath it.

CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLOCK=y

# TTY selects the INPUT core in Linux 7.2.2. Keep that unavoidable core while
# excluding every input device family and virtual-terminal user interface.
CONFIG_INPUT=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_SERIO is not set
# CONFIG_VT is not set
# CONFIG_HID is not set

# The appliance has no executable scripts, modules, workload isolation,
# network stack, persistent block device, or general-purpose filesystems.
# CONFIG_MODULES is not set
# CONFIG_BINFMT_SCRIPT is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_NET is not set
# CONFIG_VSOCKETS is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_IO_URING is not set
# CONFIG_BLK_DEV is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_NFS_FS is not set

# Virtiofs is the appliance's only host data path. DAX, passthrough, CUSE and
# io_uring integration are intentionally outside the immutable read-only use.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# CONFIG_FUSE_DAX is not set
# CONFIG_FS_DAX is not set
# CONFIG_CUSE is not set

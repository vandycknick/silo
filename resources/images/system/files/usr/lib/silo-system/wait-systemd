#!/bin/sh
set -eu

# Agent readiness precedes systemd startup. Probe the manager itself, not
# is-system-running: a booting or degraded manager can still start units.
# Bound both the whole wait and each bus call so an unresponsive manager
# cannot consume the host's entire activation deadline.
timeout 30s sh -c '
    until timeout 1s systemctl show --property=Version --value >/dev/null 2>&1; do
        sleep 0.1
    done
'

#!/bin/sh
set -eu

# Agent readiness precedes systemd startup. A Version query can succeed while
# the manager is still initializing and its control socket is transient.
# Wait for boot completion, accepting degraded boots as well as healthy ones.
# Bound both the whole wait and each bus call.
timeout 30s sh -c '
    while :; do
        state=$(timeout 1s systemctl is-system-running 2>/dev/null) || :
        case "$state" in
            running|degraded) exit 0 ;;
        esac
        sleep 0.1
    done
'
